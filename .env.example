# ==============================================================================
# PULSENEWS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Optional: Gemini API Key for Frontier AI Executive Briefings
GEMINI_API_KEY=

# Optional: Tavily AI Search API Key for domain-specific Fixed Income & Credit Risk research
TAVILY_API_KEY=

# Optional: Bearer token for securing /api/cron/sync-news against unauthorized triggers
CRON_SECRET=pulse_secret_key_12345

# ==============================================================================
# FIREBASE & FCM CONFIGURATION (Supports with or without NEXT_PUBLIC_ prefix)
# ==============================================================================
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=pulsenews.firebaseapp.com
FIREBASE_PROJECT_ID=pulsenews
FIREBASE_STORAGE_BUCKET=pulsenews.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
FIREBASE_VAPID_KEY=BNx...your_web_push_vapid_key...

# (Optional) Server Admin SDK Key for backend push triggers
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pulsenews.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
